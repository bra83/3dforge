<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>XP4NERD - Gestão Pro</title>

    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="333 Studio">

    <link rel="manifest" href="./manifest.json">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
</head>

<body class="pb-20 md:pb-0">
<div id="root"></div>

<script type="text/babel">
const { useState, useEffect, useMemo, Fragment } = React;

const App = () => {

  const HARDCODED_URL = "https://script.google.com/macros/s/AKfycbx28rB657FbmmBk05Ljd_HuBCFAGNSaflknIeF_BNYfDVUvODiZb5ry_whruDHFjcMNuw/exec";

  const [state, setState] = useState({
    estoque: [],
    vendas: [],
    gastos: [],
    syncing: false,
    settings: { urlWrite: HARDCODED_URL }
  });

  const notify = (msg) => alert(msg);

  const n = (v) => {
    if (!v) return 0;
    return parseFloat(String(v).replace(",", ".")) || 0;
  };

  /* ===================== PATCH 1 — SYNC ===================== */
  const sync = async () => {
    setState(s => ({ ...s, syncing: true }));
    try {
      const [dataRes, settingsRes] = await Promise.all([
        fetch(`${HARDCODED_URL}?type=read_data&nc=${Date.now()}`),
        fetch(`${HARDCODED_URL}?type=read_settings&nc=${Date.now()}`)
      ]);

      const data = await dataRes.json();
      const settings = await settingsRes.json();

      setState(s => ({
        ...s,
        estoque: data.estoque || [],
        vendas: data.vendas || [],
        gastos: data.gastos || [],
        settings: { ...s.settings, ...settings },
        syncing: false
      }));
    } catch (e) {
      setState(s => ({ ...s, syncing: false }));
      notify("Erro de sincronização");
    }
  };

  useEffect(() => { sync(); }, []);

  /* ===================== PATCH 2 — apiCall ===================== */
  const apiCall = async (type, data = {}) => {
    const params = new URLSearchParams({ type });
    Object.keys(data).forEach(k => params.append(k, data[k]));

    try {
      const res = await fetch(`${HARDCODED_URL}?${params.toString()}`);
      const json = await res.json();
      setTimeout(sync, 500);
      return json;
    } catch (e) {
      notify("Erro de comunicação");
      return null;
    }
  };

  return (
    <div style={{ padding: 20 }}>
      <h1>App carregado com sucesso</h1>
      <button onClick={sync}>🔄 Sincronizar</button>

      <pre>{JSON.stringify(state, null, 2)}</pre>
    </div>
  );
};

ReactDOM.createRoot(document.getElementById("root")).render(<App />);
</script>

<script>
if ("serviceWorker" in navigator) {
  navigator.serviceWorker.register("./sw.js");
}
</script>

</body>
</html>
